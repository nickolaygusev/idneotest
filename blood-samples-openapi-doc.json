{
  "openapi": "3.1.0",
  "info": {
    "title": "OpenAPI definition",
    "version": "v0"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Generated server url"
    }
  ],
  "tags": [
    {
      "name": "Blood Sample Management",
      "description": "Endpoints for managing clinical blood samples"
    }
  ],
  "paths": {
    "/blood-sample": {
      "get": {
        "tags": [
          "Blood Sample Management"
        ],
        "summary": "Retrieve blood samples",
        "description": "Returns a list of blood samples filtered by status, patientId, or date range",
        "operationId": "getSamples",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "REGISTERED",
                "PROCESSED"
              ]
            }
          },
          {
            "name": "patientId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "fromDate",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "toDate",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/BloodSampleResponseDto"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Blood Sample Management"
        ],
        "summary": "Register a new blood sample",
        "description": "Creates a new blood sample record with status REGISTERED",
        "operationId": "registerSample",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BloodSampleRequestDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/BloodSampleResponseDto"
                }
              }
            }
          }
        }
      }
    },
    "/blood-sample/{id}/process": {
      "patch": {
        "tags": [
          "Blood Sample Management"
        ],
        "summary": "Process a blood sample",
        "description": "Marks a registered blood sample as PROCESSED and sets the processing timestamp",
        "operationId": "processSample",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/BloodSampleResponseDto"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BloodSampleRequestDto": {
        "type": "object",
        "properties": {
          "patientId": {
            "type": "string",
            "format": "uuid"
          },
          "collectedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "collectedAt",
          "patientId"
        ]
      },
      "BloodSampleResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "patientId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "REGISTERED",
              "PROCESSED"
            ]
          },
          "collectedAt": {
            "type": "string",
            "format": "date-time"
          },
          "processedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}